SQLITE_PATH=./data/footruck_apollo.sqlite3
DB_NAME=footruck_apollo
JWT_SECRET=replace-with-a-long-random-value
# Frontend origin(s), comma-separated. Also the allowlist for Stripe redirect URLs.
# apollo.bcappz.com is ASSUMED until confirmed; change it here (or set FRONTEND_URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://apollo.bcappz.com
# FRONTEND_URL=https://apollo.bcappz.com
COOKIE_SECURE=false

# Optional Stripe configuration
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# FOODTRUCK_STANDARD_PRICE_ID=price_...
# FOODTRUCK_PRO_PRICE_ID=price_...
